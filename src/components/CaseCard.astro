---
import { Image } from 'astro:assets';
import T from '@/components/T.astro';
import type { CASES } from '@/lib/cases';

interface Props {
  item: (typeof CASES)[number];
  /** 卡片标题的层级，取决于所在页面的标题结构 */
  heading?: 'h2' | 'h3';
}
const { item, heading: Heading = 'h3' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<article class="cc">
  {item.image && (
    <Image class="cc-img" src={item.image} alt={item.imageAlt} widths={[480, 800]} sizes="(min-width: 800px) 520px, 100vw" format="webp" quality={82} loading="lazy" />
  )}
  <p class="cc-tag"><T zh={item.tag.zh} en={item.tag.en} /></p>
  <Heading class="cc-title">
    <a href={`${base}/work/${item.slug}`} class="cc-link"><T zh={item.title.zh} en={item.title.en} /></a>
  </Heading>
  <p class="cc-summary"><T zh={item.summary.zh} en={item.summary.en} /></p>
  <ul class="cc-stats" role="list">
    {item.stats.map((s) => (
      <li>
        <span class="cc-value">{s.value}</span>
        <span class="cc-label"><T zh={s.zh} en={s.en} /></span>
      </li>
    ))}
  </ul>
  <p class="cc-more" aria-hidden="true"><T zh="看案例" en="Read the case" /> →</p>
</article>

<style>
  .cc {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.4rem 1.4rem 1.2rem;
    background: #141719;
    border: 1px solid #2A2F33;
    border-top: 3px solid #FF5A3C;
    transition: border-color 150ms;
  }
  .cc-img { display: block; inline-size: calc(100% + 2.8rem); max-inline-size: none; margin: -1.4rem -1.4rem 1.2rem; aspect-ratio: 16 / 9; object-fit: cover; }
  .cc:hover { border-color: #FF5A3C; }
  .cc:focus-within { outline: 3px solid #EFE6D3; outline-offset: 2px; }
  .cc :global(p) { margin: 0; }
  .cc-tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9AA3A9;
  }
  .cc-title {
    margin: 0.7rem 0 0;
    font-weight: 900;
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    line-height: 1.3;
    color: #EFE6D3;
  }
  /* 整张卡片可点：把链接的点击区域铺满卡片 */
  .cc-link::after { content: ''; position: absolute; inset: 0; }
  .cc-link:focus-visible { outline: none; }
  .cc-summary { margin-top: 0.6rem !important; color: #C9CDD0; font-size: 0.95rem; line-height: 1.65; }
  .cc-stats {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid #2A2F33;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    flex: 1;
  }
  .cc-stats li { display: flex; flex-direction: column; gap: 0.25rem; }
  .cc-value {
    font-family: 'Archivo Black', 'Inter', sans-serif;
    font-size: 1.5rem;
    line-height: 1;
    color: #FF5A3C;
    font-variant-numeric: tabular-nums;
  }
  .cc-label { color: #9AA3A9; font-size: 0.8rem; line-height: 1.45; }
  .cc-more { margin-top: 1.1rem !important; color: #EFE6D3; font-weight: 600; font-size: 0.88rem; }
  .cc:hover .cc-more { color: #FF5A3C; }
</style>
