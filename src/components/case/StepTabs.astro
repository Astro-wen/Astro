---
import T from '@/components/T.astro';

/**
 * StepTabs —— 可点的流程图。每个节点是一个 tab，下面的面板显示这一步的说明。
 * 键盘：方向键在节点间移动，选中跟随焦点（focusgroup，缺失时加载 polyfill）。
 * tone: 'gate' 校验节点，'human' 人工节点。meter: [lo, hi] 在面板里画一段 0–1 的区间。
 */
interface Step {
  zh: string;
  en: string;
  noteZh: string;
  noteEn: string;
  tone?: 'gate' | 'human' | 'stop';
  meter?: [number, number];
}
interface Props {
  id: string;
  steps: Step[];
  labelZh: string;
  labelEn: string;
  captionZh?: string;
  captionEn?: string;
  /** 节点之间是否画连接线（流程）还是只是并列选项 */
  connected?: boolean;
}
const { id, steps, labelZh, labelEn, captionZh, captionEn, connected = true } = Astro.props;
const toneLabel = {
  gate: { zh: '校验', en: 'Gate' },
  human: { zh: '人工', en: 'Human' },
  stop: { zh: '卡住', en: 'Stuck' },
};
---
<figure class="st" data-step-tabs>
  <p class="st-label" id={`${id}-label`}><T zh={labelZh} en={labelEn} /></p>
  <div
    class:list={['st-list', connected && 'st-list--connected']}
    focusgroup="tablist nomemory"
    aria-labelledby={`${id}-label`}
  >
    {steps.map((s, i) => (
      <button
        type="button"
        class:list={['st-tab', s.tone && `st-tab--${s.tone}`]}
        id={`${id}-tab-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        focusgroupstart={i === 0}
      >
        <span class="st-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="st-name"><T zh={s.zh} en={s.en} /></span>
        {s.tone && <span class="st-tone"><T zh={toneLabel[s.tone].zh} en={toneLabel[s.tone].en} /></span>}
      </button>
    ))}
  </div>
  <div class="st-panels">
    {steps.map((s, i) => (
      <div
        role="tabpanel"
        class="st-panel"
        aria-labelledby={`${id}-tab-${i}`}
        tabindex={i === 0 ? 0 : undefined}
        hidden={i === 0 ? undefined : 'until-found'}
      >
        <div class="st-panel-inner">
          <p class="st-note"><T zh={s.noteZh} en={s.noteEn} /></p>
          {s.meter && (
            <div class="st-meter" aria-hidden="true">
              <span class="st-meter-track">
                <span
                  class="st-meter-fill"
                  style={`--lo: ${s.meter[0]}; --hi: ${s.meter[1]};`}
                ></span>
              </span>
              <span class="st-meter-axis"><span>0</span><span>0.5</span><span>1</span></span>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
  {captionZh && <figcaption class="st-caption"><T zh={captionZh} en={captionEn ?? captionZh} /></figcaption>}
</figure>

<script>
  if (!Object.hasOwn(HTMLElement.prototype, 'focusGroup')) {
    const { polyfill } = await import('@microsoft/focusgroup-polyfill');
    polyfill();
  }

  document.querySelectorAll<HTMLElement>('[data-step-tabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('.st-list')!;
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('.st-tab'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.st-panel'));

    function select(index: number) {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.ariaSelected = String(on);
        tab.toggleAttribute('focusgroupstart', on);
        const panel = panels[i];
        if (on) {
          panel.removeAttribute('hidden');
          panel.tabIndex = 0;
        } else {
          // 不支持 until-found 的浏览器会退回成普通 hidden
          (panel as HTMLElement & { hidden: boolean | string }).hidden = 'until-found';
          panel.removeAttribute('tabindex');
        }
      });
      tabs[index].scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest' } as ScrollIntoViewOptions);
    }

    tabs.forEach((tab, i) => {
      // 选中跟随焦点：切换面板没有成本
      tab.addEventListener('focus', () => select(i));
      tab.addEventListener('click', () => select(i));
    });
    // 页内查找命中隐藏面板时，同步选中状态
    panels.forEach((panel, i) => panel.addEventListener('beforematch', () => select(i)));
  });
</script>

<style>
  @property --fade-start { syntax: '<length>'; inherits: false; initial-value: 0px; }
  @property --fade-end { syntax: '<length>'; inherits: false; initial-value: 0px; }

  .st { margin: 1.5rem 0; }
  .st-label {
    margin: 0 0 0.6rem;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8A949B;
  }

  /* 单行不换行；放不下就横向滚动，两端渐隐 */
  .st-list {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 4px;
    --fade-size: 2.5rem;
    scroll-padding-inline: var(--fade-size);
    mask:
      linear-gradient(black, black) no-clip subtract,
      linear-gradient(to right, black, transparent) 0 0 / var(--fade-start) 100% no-repeat no-clip,
      linear-gradient(to right, transparent, black) 100% 0 / var(--fade-end) 100% no-repeat no-clip;
    animation: st-reveal-start linear both, st-hide-end linear both;
    animation-timeline: scroll(self inline);
    animation-range: 0 var(--fade-size), calc(100% - var(--fade-size)) 100%;
  }
  .st-list::-webkit-scrollbar { display: none; }
  @keyframes st-reveal-start { to { --fade-start: var(--fade-size); } }
  @keyframes st-hide-end { from { --fade-end: var(--fade-size); } }

  .st-tab {
    position: relative;
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    min-inline-size: 8.5rem;
    max-inline-size: 13rem;
    min-block-size: 44px;
    padding: 0.7rem 0.8rem 0.85rem;
    text-align: left;
    background: #141719;
    border: 1px solid #2A2F33;
    color: #C9CDD0;
    font: inherit;
    cursor: pointer;
  }
  .st-tab:hover { border-color: #626A70; }
  .st-tab:focus-visible { outline: 3px solid #EFE6D3; outline-offset: 2px; }
  /* 节点之间的连接线：画在间隙里，纯装饰 */
  .st-list--connected .st-tab + .st-tab::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 100%;
    width: 1.25rem;
    border-top: 1px solid #626A70;
    margin-right: 1px;
  }
  .st-num { font-size: 11px; letter-spacing: 0.15em; color: #9AA3A9; font-variant-numeric: tabular-nums; }
  .st-name { font-weight: 600; font-size: 0.92rem; line-height: 1.35; color: #EFE6D3; }
  .st-tone { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; }
  .st-tab--gate .st-tone { color: #F4C341; }
  .st-tab--human .st-tone { color: #29D2C8; }
  .st-tab--stop .st-tone { color: #FF7359; }

  /* 选中：底部一条粗线（形状），不改变节点尺寸 */
  .st-tab[aria-selected='true'] { background: #1C2023; }
  .st-tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    inset: auto -1px -1px;
    border-block-end: 3px solid #FF5A3C;
  }

  /* 面板共用一个格子；内边距放在内层，隐藏面板不留空条 */
  .st-panels { display: grid; margin-top: 0.75rem; }
  .st-panel { grid-area: 1 / 1; }
  .st-panel:focus-visible { outline: 3px solid #EFE6D3; outline-offset: 2px; }
  .st-panel-inner {
    padding: 0.9rem 1rem;
    border-left: 3px solid #FF5A3C;
    background: #141719;
    min-block-size: 4.5rem;
  }
  .st :global(.st-note) { margin: 0; color: #EFE6D3; max-width: 62ch; font-size: 0.98rem; }

  .st-meter { margin-top: 0.8rem; max-width: 22rem; }
  .st-meter-track {
    position: relative;
    display: block;
    height: 10px;
    background: #4A2219;
    border-radius: 2px;
  }
  .st-meter-fill {
    position: absolute;
    inset-block: 0;
    left: calc(var(--lo) * 100%);
    width: calc((var(--hi) - var(--lo)) * 100%);
    background: #FF5A3C;
    border-radius: 2px;
  }
  .st-meter-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.25rem;
    font-size: 11px;
    color: #9AA3A9;
    font-variant-numeric: tabular-nums;
  }
  .st-caption { margin-top: 0.6rem; color: #9AA3A9; font-size: 0.82rem; }
</style>
