---
import T from '@/components/T.astro';

/**
 * Lanes —— 上下两条泳道对比两个版本的流程。每条泳道是一个有序列表。
 * 节点 tone: 'new' 表示这一版新增，'stop' 表示流程在这里断了。
 */
interface Node { zh: string; en: string; tone?: 'new' | 'stop' }
interface Lane { nameZh: string; nameEn: string; nodes: Node[] }
interface Props { lanes: Lane[]; captionZh: string; captionEn: string }
const { lanes, captionZh, captionEn } = Astro.props;
---
<figure class="ln">
  {lanes.map((lane) => (
    <div class="ln-lane">
      <p class="ln-name"><T zh={lane.nameZh} en={lane.nameEn} /></p>
      <ol class="ln-nodes" role="list">
        {lane.nodes.map((n) => (
          <li class:list={['ln-node', n.tone && `ln-node--${n.tone}`]}>
            <T zh={n.zh} en={n.en} />
            {n.tone === 'new' && <span class="ln-flag"><T zh="新增" en="New" /></span>}
            {n.tone === 'stop' && <span class="ln-flag"><T zh="断在这里" en="Stops here" /></span>}
          </li>
        ))}
      </ol>
    </div>
  ))}
  <figcaption class="ln-caption"><T zh={captionZh} en={captionEn} /></figcaption>
</figure>

<style>
  .ln { margin: 1.5rem 0; }
  .ln-lane {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 0;
    border-top: 1px solid #2A2F33;
  }
  .ln-lane:last-of-type { border-bottom: 1px solid #2A2F33; }
  .ln :global(.ln-name) {
    margin: 0;
    font-family: 'Archivo Black', 'Inter', sans-serif;
    font-size: 1.25rem;
    color: #EFE6D3;
  }
  .ln-nodes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; }
  .ln-node {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.75rem;
    background: #141719;
    border: 1px solid #2A2F33;
    color: #EFE6D3;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .ln-node + .ln-node::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 100%;
    width: 1.5rem;
    border-top: 1px solid #626A70;
    margin-right: 1px;
  }
  .ln-node--new { border-color: #29D2C8; }
  .ln-node--stop { border-color: #FF7359; border-style: dashed; }
  .ln-flag { font-size: 10.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .ln-node--new .ln-flag { color: #29D2C8; }
  .ln-node--stop .ln-flag { color: #FF7359; }
  .ln-caption { margin-top: 0.6rem; color: #9AA3A9; font-size: 0.82rem; }
  @media (max-width: 560px) {
    .ln-lane { grid-template-columns: 1fr; }
  }
</style>
