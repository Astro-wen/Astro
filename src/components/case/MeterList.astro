---
import T from '@/components/T.astro';

/**
 * MeterList —— 每行一个名称、一条横条、一个数字，横条左对齐共用同一条基线。
 * 数字用正文色，颜色只出现在横条上；轨道是同一色相的暗一档。
 */
interface Row {
  zh: string;
  en: string;
  value: number;
  total: number;
  /** 显示在行尾的数字，例如 "23 / 29" */
  figure: string;
}
interface Props {
  rows: Row[];
  titleZh: string;
  titleEn: string;
  noteZh?: string;
  noteEn?: string;
}
const { rows, titleZh, titleEn, noteZh, noteEn } = Astro.props;
---
<figure class="ml">
  <figcaption class="ml-title"><T zh={titleZh} en={titleEn} /></figcaption>
  <ul class="ml-rows" role="list">
    {rows.map((r) => (
      <li class="ml-row">
        <span class="ml-name"><T zh={r.zh} en={r.en} /></span>
        <span class="ml-track" aria-hidden="true">
          <span class="ml-fill" style={`--share: ${r.value / r.total};`}></span>
        </span>
        <span class="ml-figure">{r.figure}</span>
      </li>
    ))}
  </ul>
  {noteZh && <p class="ml-note"><T zh={noteZh} en={noteEn ?? noteZh} /></p>}
</figure>

<style>
  .ml { margin: 1.5rem 0; max-width: 40rem; }
  .ml-title { color: #EFE6D3; font-weight: 600; font-size: 0.95rem; }
  .ml-rows { list-style: none; margin: 0.9rem 0 0; padding: 0; display: grid; gap: 0.8rem; }
  .ml-row {
    display: grid;
    grid-template-columns: minmax(6rem, 9rem) 1fr auto;
    align-items: center;
    gap: 0.9rem;
  }
  .ml-name { color: #C9CDD0; font-size: 0.9rem; line-height: 1.35; }
  .ml-track { display: block; height: 14px; background: #4A2219; border-radius: 0 4px 4px 0; }
  .ml-fill {
    display: block;
    height: 100%;
    width: calc(var(--share) * 100%);
    background: #FF5A3C;
    border-radius: 0 4px 4px 0;
  }
  .ml-figure {
    color: #EFE6D3;
    font-weight: 600;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    min-width: 4.5rem;
    text-align: right;
  }
  .ml :global(.ml-note) { margin: 0.8rem 0 0; color: #9AA3A9; font-size: 0.82rem; }
  @media (max-width: 480px) {
    .ml-row { grid-template-columns: 1fr auto; }
    .ml-name { grid-column: 1 / -1; }
  }
</style>
