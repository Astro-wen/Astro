---
import T from '@/components/T.astro';

interface Props {
  index: string;
  zh: string;
  en: string;
  /** 这一节主要写给谁看，例如 "PM" / "SWE" / "DS" */
  audience?: string;
  id?: string;
}
const { index, zh, en, audience, id } = Astro.props;
---
<section class="case-section" id={id}>
  <div class="flex items-baseline gap-4 flex-wrap">
    <span class="font-display text-brand text-3xl leading-none tabular-nums" aria-hidden="true">{index}</span>
    <h2 class="display-lg text-xl sm:text-2xl text-ink-900 leading-tight flex-1 min-w-0">
      <T zh={zh} en={en} />
    </h2>
    {audience && (
      <span class="section-eyebrow shrink-0">
        <T zh={`给 ${audience} 看`} en={`For ${audience}`} />
      </span>
    )}
  </div>
  <div class="mt-3 h-px bg-line"></div>
  <div class="case-body mt-6">
    <slot />
  </div>
</section>

<style>
  .case-section { margin-top: 4rem; scroll-margin-top: 5rem; }
  .case-body :global(p) { color: #C9CDD0; max-width: 68ch; }
  .case-body :global(p + p) { margin-top: 0.9rem; }
  .case-body :global(strong) { color: #EFE6D3; font-weight: 600; }
  .case-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.6rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: #EFE6D3;
  }
  .case-body :global(ul.case-list) { margin-top: 0.75rem; max-width: 68ch; }
  .case-body :global(ul.case-list > li) {
    position: relative;
    padding-left: 1.1rem;
    color: #C9CDD0;
    line-height: 1.75;
  }
  .case-body :global(ul.case-list > li + li) { margin-top: 0.45rem; }
  .case-body :global(ul.case-list > li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 6px;
    height: 2px;
    background: #FF5A3C;
  }
  .case-body :global(code) {
    font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
    font-size: 0.85em;
    color: #E0B587;
  }
</style>
