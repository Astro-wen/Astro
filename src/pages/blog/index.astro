---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="文章 Writing" description="文章列表">
  <section class="container-prose py-12 sm:py-16">
    <h1 class="display-lg text-3xl sm:text-5xl text-ink-900 leading-tight">
      <span class="i18n-zh">文章</span><span class="i18n-en">Writing</span>
    </h1>

    <div class="mt-8">
      {allPosts.length === 0 ? (
        <p class="text-ink-500">还没有文章，稍后再来吧。</p>
      ) : (
        allPosts.map((post) => <PostCard post={post} />)
      )}
    </div>
  </section>
</BaseLayout>
