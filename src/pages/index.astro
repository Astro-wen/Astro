---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CaseCard from '@/components/CaseCard.astro';
import LogoPlaceholder from '@/components/LogoPlaceholder.astro';
import PostCard from '@/components/PostCard.astro';
import T from '@/components/T.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@/lib/site';
import { CASES } from '@/lib/cases';
import { sortExperience, formatRange } from '@/lib/timeline';

const all = await getCollection('timeline');
const experiences = sortExperience(all.filter((t) => t.data.kind === 'work'));
const education = all.filter((t) => t.data.kind === 'education');
// 首页只列最近几段，完整内容在 /experience
const recent = experiences.slice(0, 5);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={SITE.name} description={SITE.description} mascot>
  <Hero />

  {/* ============ 作品 ============ */}
  <section id="work" class="container-wide py-12 sm:py-16 scroll-mt-20">
    <SectionHeader index="01" title="作品" tag="Work" />
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-5" role="list">
      {CASES.map((c) => <li><CaseCard item={c} /></li>)}
    </ul>
    <p class="mt-6 text-right">
      <a href={`${base}/work`} class="home-more"><T zh="全部作品" en="All work" /> <span aria-hidden="true">→</span></a>
    </p>
  </section>

  {/* ============ 经历（精简） ============ */}
  <section id="experience" class="container-wide py-12 sm:py-16 scroll-mt-20">
    <SectionHeader index="02" title="经历" tag="Experience" />
    <ul class="xp" role="list">
      {recent.map((e) => (
        <li class="xp-row">
          <LogoPlaceholder logo={e.data.logo} name={e.data.orgShort || e.data.org} tint={e.data.tint} size={40} />
          <span class="xp-main">
            <span class="xp-org"><T zh={e.data.orgZh ?? e.data.org} en={e.data.orgEn ?? e.data.org} /></span>
            <span class="xp-role"><T zh={e.data.role} en={e.data.roleEn ?? e.data.role} /></span>
          </span>
          <span class="xp-date">
            <T zh={formatRange(e.data.start, e.data.end, 'zh')} en={formatRange(e.data.start, e.data.end, 'en')} />
          </span>
        </li>
      ))}
      {education.map((e) => (
        <li class="xp-row">
          <LogoPlaceholder logo={e.data.logo} name={e.data.orgShort || e.data.org} tint={e.data.tint} size={40} />
          <span class="xp-main">
            <span class="xp-org"><T zh={e.data.orgZh ?? e.data.org} en={e.data.orgEn ?? e.data.org} /></span>
            <span class="xp-role"><T zh={e.data.role} en={e.data.roleEn ?? e.data.role} /></span>
          </span>
          <span class="xp-date">
            <T zh={formatRange(e.data.start, e.data.end, 'zh')} en={formatRange(e.data.start, e.data.end, 'en')} />
          </span>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-right">
      <a href={`${base}/experience`} class="home-more">
        <T zh={`完整经历（共 ${experiences.length} 段）`} en={`Full experience (${experiences.length} roles)`} /> <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>

  {/* ============ 文章 ============ */}
  {posts.length > 0 && (
    <section id="writing" class="container-wide py-12 sm:py-16 scroll-mt-20">
      <SectionHeader index="03" title="文章" tag="Writing" />
      <div>
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <p class="mt-6 text-right">
        <a href={`${base}/blog`} class="home-more"><T zh="全部文章" en="All posts" /> <span aria-hidden="true">→</span></a>
      </p>
    </section>
  )}
</BaseLayout>

<style>
  .home-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 32px;
    color: #C9CDD0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #626A70;
  }
  .home-more:hover { color: #FF5A3C; border-bottom-color: #FF5A3C; }

  .xp { list-style: none; margin: 0; padding: 0; border-top: 1px solid #2A2F33; }
  .xp-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid #2A2F33;
  }
  .xp-main { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .xp-org { color: #EFE6D3; font-weight: 700; font-size: 1rem; line-height: 1.35; }
  .xp-role { color: #9AA3A9; font-size: 0.88rem; line-height: 1.45; }
  .xp-date { color: #9AA3A9; font-size: 0.85rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  @media (max-width: 520px) {
    .xp-row { grid-template-columns: auto 1fr; }
    .xp-date { grid-column: 2; }
  }
</style>
