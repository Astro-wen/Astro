        animation: nq-hero-out linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 90vh;
      }

      /* 插上就传：照片从接口特写拉远成一张圆角图 */
      .nq-zoom { block-size: 300vh; view-timeline: --nq-zoom block; }
      .nq-zoom-stage {
        position: sticky;
        inset-block-start: 0;
        block-size: 100svh;
        max-inline-size: none;
        padding: 0;
        display: block;
        overflow: clip;
      }
      .nq-zoom-frame {
        position: absolute;
        inset: 0;
        margin: auto;
        inline-size: min(94vw, 160svh, 1500px);
        block-size: fit-content;
        transform-origin: 52% 55%;
        animation: nq-zoom-frame linear both;
        animation-timeline: --nq-zoom;
        animation-range: contain 0% contain 100%;
      }
      .nq-zoom-copy {
        position: absolute;
