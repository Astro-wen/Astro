  @keyframes nq-rise {
    from { opacity: 0; transform: translateY(48px) scale(0.96); }
    to { opacity: 1; transform: none; }
  }
  @keyframes nq-step-1 { 0%, 28% { opacity: 1; } 36%, 100% { opacity: 0.28; } }
  @keyframes nq-step-2 { 0%, 28% { opacity: 0.28; } 36%, 62% { opacity: 1; } 70%, 100% { opacity: 0.28; } }
  @keyframes nq-step-3 { 0%, 62% { opacity: 0.28; } 70%, 100% { opacity: 1; } }
  @keyframes nq-view-2 { 0%, 28% { opacity: 0; transform: translateY(18px); } 36%, 100% { opacity: 1; transform: none; } }
  @keyframes nq-view-3 { 0%, 62% { opacity: 0; transform: translateY(18px); } 70%, 100% { opacity: 1; transform: none; } }
</style>

<script>
  // 首屏标题：两组词轮流换，一次只动一组
  const roll = document.querySelector<HTMLElement>('[data-roll]');
  // 槽位宽度跟着当前的词走，短词后面不留空
  const fit = (slot: HTMLElement) => {
    const cur = slot.querySelector<HTMLElement>('.nq-word.is-in');
    if (cur && cur.offsetWidth) slot.style.inlineSize = `${cur.offsetWidth}px`;
  };
  const fitAll = () => roll?.querySelectorAll<HTMLElement>('.nq-slot').forEach(fit);
  if (roll) {
    fitAll();
    document.fonts?.ready.then(fitAll);
    addEventListener('resize', fitAll);
    new MutationObserver(fitAll).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });
  }
  if (roll && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const step = (kind: string) => {
      roll.querySelectorAll<HTMLElement>(`[data-slot="${kind}"]`).forEach((slot) => {
        const words = [...slot.querySelectorAll<HTMLElement>('.nq-word')];
        const cur = words.findIndex((w) => w.classList.contains('is-in'));
        const next = (cur + 1) % words.length;
        words.forEach((w) => w.classList.remove('is-out'));
        words[cur].classList.replace('is-in', 'is-out');
        words[next].classList.add('is-in');
        fit(slot);
      });
    };
    let tick = 0;
    setInterval(() => { if (!document.hidden) step(tick++ % 2 === 0 ? 'y' : 'x'); }, 1580);
  }
  document.querySelectorAll<HTMLImageElement>('.nq img').forEach((img) => { img.draggable = false; });

  // 头部配色：深色区域的上沿碰到头部下沿之前，头部用浅色
  const pilot = document.querySelector<HTMLElement>('.nq-pilot');
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  if (pilot && siteHeader) {
    let queued = false;
    const sync = () => {
      queued = false;
      document.body.classList.toggle('nq-light-header', pilot.getBoundingClientRect().top > siteHeader.offsetHeight / 2);
    };
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(sync); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    sync();
  }
</script>

<style is:global>
  /* 这一页上半是浅色、下半是深色。站点头部默认是深色的，
     在浅色区域由脚本给 body 加 nq-light-header，这里把颜色全部写死，不依赖变量联动。 */
  body.nq-light-header .site-header { background: rgb(255 255 255 / 0.94); border-bottom-color: #E5E5EA; }
  body.nq-light-header .site-logo,
  body.nq-light-header .menu-button,
  body.nq-light-header .site-header.is-wide .site-menu a { color: #1D1D1F; }
  body.nq-light-header .menu-button { border-color: #D2D2D7; }
  body.nq-light-header .site-logo:focus-visible,
  body.nq-light-header .menu-button:focus-visible,
  body.nq-light-header .site-header.is-wide .site-menu a:focus-visible { outline-color: #1D1D1F; }
  body.nq-light-header .site-header.is-wide .site-menu a:hover,
  body.nq-light-header .site-header.is-wide .site-menu a[aria-current='page'] { color: #D93A1E; }
  body.nq-light-header .lang-switch { border-color: #B9BCC4; }
  body.nq-light-header .lang-switch button:not(.is-active) { color: #1D1D1F; }
  body.nq-page footer.mt-32 { margin-top: 0; }
</style>
