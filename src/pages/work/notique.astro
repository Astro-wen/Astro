        animation-timeline: --nq-zoom;
        animation-range: contain 0% contain 100%;
      }
      .nq-zoom-stat .nq-big { font-size: clamp(3rem, 9vw, 6rem); }

      /* 拼格和截图：进入视口时浮上来 */
      .nq-tile, .nq-pilot-intro > * {
        animation: nq-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }

      /* Pilot：三步对应三张真实界面，滚动切换 */
      @media (min-width: 62rem) {
        .nq-steps { block-size: 340vh; view-timeline: --nq-steps block; }
        .nq-steps-stage {
          position: sticky;
          inset-block-start: 0;
          block-size: 100svh;
          grid-template-columns: minmax(0, 3fr) minmax(0, 10fr);
          grid-template-rows: 1fr auto auto auto 1fr;
          column-gap: 3rem;
          row-gap: 1.75rem;
        }
        .nq-step { display: contents; }
        .nq-step-text { grid-column: 1; }
        .nq-step-1 .nq-step-text { grid-row: 2; }
        .nq-step-2 .nq-step-text { grid-row: 3; }
        .nq-step-3 .nq-step-text { grid-row: 4; }
        .nq-browser { grid-column: 2; grid-row: 1 / -1; align-self: center; }
        .nq-step-text, .nq-browser {
          animation-duration: auto;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: --nq-steps;
          animation-range: contain 0% contain 100%;
        }
        .nq-step-1 .nq-step-text { animation-name: nq-step-1; }
        .nq-step-2 .nq-step-text { animation-name: nq-step-2; }
        .nq-step-3 .nq-step-text { animation-name: nq-step-3; }
        .nq-step-2 .nq-browser { animation-name: nq-view-2; }
        .nq-step-3 .nq-browser { animation-name: nq-view-3; }
      }
    }
  }

  @keyframes nq-hero-out { to { transform: scale(1.12) translateY(-4%); } }
  @keyframes nq-zoom-frame {
    0%, 12% { transform: scale(1.7); border-radius: 0; }
    62%, 100% { transform: scale(1); border-radius: 28px; }
  }
  @keyframes nq-zoom-title {
    0%, 14% { opacity: 1; transform: none; }
    40%, 100% { opacity: 0; transform: translateY(-6svh) scale(0.94); }
  }
  @keyframes nq-zoom-stat {
    0%, 58% { opacity: 0; transform: translateY(24px); }
    74%, 100% { opacity: 1; transform: none; }
