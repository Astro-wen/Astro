---
import CaseLayout from '@/layouts/CaseLayout.astro';
import CaseSection from '@/components/case/CaseSection.astro';
import StepTabs from '@/components/case/StepTabs.astro';
import Cards from '@/components/case/Cards.astro';
import MeterList from '@/components/case/MeterList.astro';
import T from '@/components/T.astro';

const facts = [
  {
    label: { zh: '角色', en: 'Role' },
    value: { zh: 'AI 产品经理实习生，客服平台', en: 'AI Product Manager Intern, Customer Service Platform' },
  },
  {
    label: { zh: '时间', en: 'When' },
    value: { zh: '2026 年 6 月至 9 月', en: 'Jun to Sep 2026' },
  },
  {
    label: { zh: '我做的部分', en: 'What I did' },
    value: {
      zh: '产品方案、前端实现（AI coding，交研发评审合入）、联调和验收',
      en: 'Product design, front-end implementation (AI coding, reviewed and merged by engineers), integration and acceptance',
    },
  },
];

const metrics = [
  { value: '~100', zh: '名评审员，来自四个团队', en: 'reviewers across four teams' },
  { value: '250–300', zh: '单每小时，此前不足 70', en: 'cases per hour, up from under 70' },
  { value: '18', zh: '处数值错误被门禁拦下', en: 'numeric errors caught by the gate' },
  { value: '<30 min', zh: '完成一次指标波动排查', en: 'to investigate a metric swing' },
];

const chain = [
  { zh: '用户提问', en: 'User asks', noteZh: '先自助查帮助中心，查不到进客服机器人', noteEn: 'Self-service help first, then the support chatbot' },
  { zh: '机器人回答', en: 'Chatbot answers', noteZh: '多智能体系统：识别意图、规划、执行、组织回复', noteEn: 'A multi-agent system: intent, planning, execution, response' },
  { zh: 'AI 给会话打分', en: 'AI scores the conversation', noteZh: '按六个维度评服务质量，每天自动跑', noteEn: 'Service quality on six dimensions, run automatically every day' },
  { zh: '人工标注基准', en: 'Human ground truth', noteZh: '评审员给同一批会话打分，用来检验 AI 打得准不准', noteEn: 'Reviewers score the same conversations to check whether the AI scores are right', tone: 'human' as const },
  { zh: '版本对比报告', en: 'Version comparison report', noteZh: '新版本比旧版本好还是坏，管理层据此决定是否发版', noteEn: 'Is the new version better or worse; leadership decides the release on it' },
];

const report = [
  { zh: '上传标注数据', en: 'Upload labelled data', noteZh: '新旧两个版本各一份。', noteEn: 'One file each for the old and new version.' },
  { zh: '脚本算数', en: 'Scripts compute the numbers', noteZh: '分子、分母、达标率、显著性。全部用 SQL 和 Python', noteEn: 'Numerators, denominators, pass rates, significance. All in SQL and Python' },
  { zh: '对账门禁', en: 'Reconciliation gate', noteZh: '报告里的数字复算一遍，对不上就阻断写入', noteEn: 'Every number in the report is recomputed; a mismatch blocks publishing', tone: 'gate' as const },
  { zh: 'AI 写解释', en: 'AI writes the explanation', noteZh: '根因归因、场景分析、典型案例。AI 不碰数字', noteEn: 'Root-cause attribution, scenario analysis, example cases. The AI never touches the numbers' },
  { zh: '独立判卷', en: 'Independent grading', noteZh: '另一个只读程序对照人工确认的答案打分，和主流程不共享代码', noteEn: 'A separate read-only program grades against human-confirmed answers and shares no code with the main flow', tone: 'gate' as const },
];

const loop = [
  { zh: '分析', en: 'Analyse', noteZh: '指标异常，定位到哪类会话', noteEn: 'A metric moves; find which conversations' },
  { zh: '归因', en: 'Attribute', noteZh: '结合会话和配置找原因', noteEn: 'Find the cause from conversations and configuration' },
  { zh: '改方案', en: 'Revise', noteZh: '生成修改建议', noteEn: 'Propose a change' },
  { zh: '评测', en: 'Evaluate', noteZh: '用同一批案例、同一套规则比新旧版本。不通过就退回上一步', noteEn: 'Compare old and new on the same cases with the same rules. A fail goes back one step', tone: 'gate' as const },
  { zh: '报告', en: 'Report', noteZh: '把评测结果整理成可复算的报告', noteEn: 'Turn the evaluation into a reproducible report' },
  { zh: '人工审核', en: 'Human review', noteZh: '通过后才进线上实验', noteEn: 'Only then does it go to a live experiment', tone: 'human' as const },
];

const layers = [
  { zh: '第一层：服务好不好', en: 'Layer 1: is the service good', bodyZh: 'AI 每天按六个维度给会话打分。', bodyEn: 'AI scores conversations on six dimensions every day.', tagZh: '看得见的数字', tagEn: 'The visible number' },
  { zh: '第二层：AI 打的分准不准', en: 'Layer 2: are the AI scores right', bodyZh: '拿人工标注去比。这层不达标，上一层的涨跌说明不了任何事。', bodyEn: 'Compared against human labels. If this fails, movements in layer 1 mean nothing.', tagZh: '地基 · 我在这一层', tagEn: 'The foundation · where I worked' },
];

const platformDecisions = [
  { zh: '标准写成页面规则', en: 'The standard as page rules', bodyZh: '打了分必须写理由，校验和 AI 评估侧用同一套。', bodyEn: 'A score needs a reason; validation matches the AI evaluation.' },
  { zh: '标注和质检并行', en: 'Label and audit in parallel', bodyZh: '双盲。做过标注的人不能质检同一任务，质检员看到空白卷。', bodyEn: 'Double-blind. A labeller cannot audit the same task; auditors start blank.' },
  { zh: '隐私失败时关闭', en: 'Fail closed on privacy', bodyZh: '打码一旦失败，页面不可用，不返回原文，不允许提交。这条是我坚持加的。', bodyEn: 'If masking fails the page is unavailable, returns no original text and blocks submission. I pushed for this.' },
  { zh: '申诉流程', en: 'Appeals flow', bodyZh: '方案做完后重算投入产出，不成立。改为输出冲突清单留给下一期。', bodyEn: 'The cost did not justify it once designed. Replaced by a conflict list for the next phase.', tagZh: '砍掉', tagEn: 'Cut', tone: 'cut' as const },
];

const throughput = [
  { zh: '之前：各团队的表格', en: 'Before: team spreadsheets', value: 70, total: 300, figure: '< 70' },
  { zh: '之后：评估平台', en: 'After: the platform', value: 275, total: 300, figure: '250–300' },
];

const accuracy = [
  { zh: '数据结论', en: 'Data conclusions', value: 10, total: 10, figure: '10 / 10' },
  { zh: '场景分析', en: 'Scenario analysis', value: 23, total: 29, figure: '23 / 29' },
  { zh: '根因归因', en: 'Root-cause attribution', value: 29, total: 44, figure: '29 / 44' },
];

const reportStats = [
  { value: '100%', zh: '稳定率：5 次独立运行与多数派完全一致，6 个数据集', en: 'stability: 5 isolated runs match the majority exactly, 6 datasets' },
  { value: '78.7%', zh: '准确率：对照人工确认的答案，区间 64.7% 到 95.2%', en: 'accuracy against human-confirmed answers, range 64.7% to 95.2%' },
  { value: '18', zh: '处数值偏差，在一次实际运行里被对账门禁拦下', en: 'numeric discrepancies caught by the gate in one real run' },
];

const lessons = [
  { zh: '没拿真实文件验证', en: 'Never tested a real file', bodyZh: '评审员的表格少一个字段，导入失败，迁移推迟两天。之后验收改成每个团队用真实数据跑完整流程再签字。', bodyEn: 'Reviewers’ sheets lacked a field, imports failed, migration slipped two days. Acceptance now means each team runs the full flow on real data.', tagZh: '评估平台', tagEn: 'Platform' },
  { zh: '全是缺失值却显示通过', en: 'All missing, marked passing', bodyZh: '表头和配置不一致，模糊匹配太宽又没有硬失败。之后关键指标列缺失直接报错。', bodyEn: 'Headers did not match the config; fuzzy matching was loose and nothing failed hard. A missing key column now raises an error.', tagZh: '质量报告', tagEn: 'Report' },
  { zh: '根因判断只验证了 5 条', en: 'Root cause validated on 5 samples', bodyZh: '交接里写明：人工标注验证完成前，不建议用于正式分析。', bodyEn: 'The handover says not to use it for formal analysis until validated against human labels.', tagZh: '自迭代系统', tagEn: 'Self-improving system' },
];

const search = [
  { zh: '11 类显示差异', en: '11 display mismatches', bodyZh: '后台展示和用户实际看到的不一致。逐类定位成因再分派研发。', bodyEn: 'The back office differed from what users saw. Each traced to a cause and routed to engineering.' },
  { zh: '评分进列表', en: 'Scores in the list', bodyZh: '找一批低分会话，从跨系统导出再回查，变成一次筛选。', bodyEn: 'Finding low-scoring conversations went from a cross-system export to one filter.' },
  { zh: '自然语言检索', en: 'Natural-language search', bodyZh: '直接描述想找的案例，不用手动设置 21 个以上的筛选项。', bodyEn: 'Describe the case you want instead of setting 21+ filters by hand.' },
];
---

<CaseLayout
  pageTitle="TikTok 客服 AI 评估案例"
  description="在 TikTok 客服平台做 AI 评估：人工评估平台、可复算的质量报告，以及自迭代系统里的评测环节。内容已脱敏。"
  kicker={{ zh: '案例 · TikTok 实习 · 已脱敏', en: 'Case study · TikTok internship · De-identified' }}
  title={{ zh: '客服机器人答得好不好，这个判断准不准', en: 'Is the chatbot any good, and can we trust that verdict' }}
  summary={{
    zh: '团队每天用 AI 给客服机器人的回答打分。我做的是让这个打分可信的三件事：人工标注可审计，版本报告可复算，自动迭代有验收关。',
    en: 'The team uses AI to score the support chatbot every day. I worked on three things that make that score trustworthy: auditable human labels, reproducible version reports, and an acceptance gate for automated iteration.',
  }}
  facts={facts}
  metrics={metrics}
  disclosure={{
    zh: '脱敏说明：本页不含内部截图和文档链接。内部平台名、同事姓名、区域划分和业务指标的目标值已省略或改用通用说法，流程图为重新绘制。保留的数字都是我所做工具自身的结果。AI 评分准确率的提升是团队产出，由算法侧推进。',
    en: 'De-identification: no internal screenshots or document links. Internal platform names, colleagues’ names, regional breakdowns and business targets are omitted or generalised, and the diagrams are redrawn. The numbers kept describe the tools I built. Improving AI scoring accuracy was a team result led by the algorithm side.',
  }}
>
  <CaseSection index="01" zh="评估链路，以及我在哪一段" en="The evaluation chain, and where I worked">
    <StepTabs
      id="chain"
      steps={chain}
      labelZh="从用户提问到发版决定 · 点任意一步"
      labelEn="From a question to a release decision · select a step"
    />
    <Cards cards={layers} />
  </CaseSection>

  <CaseSection index="02" zh="人工评估平台" en="Human evaluation platform" audience="PM">
    <p>
      <T
        zh="评分标准换代后，近 100 名评审员退回各自的表格。<strong>谁标的、谁复核的、以哪个为准，追不回来。</strong>"
        en="When the scoring standard changed, nearly 100 reviewers fell back to their own spreadsheets. <strong>Who labelled, who reviewed, and which result was final could not be traced.</strong>"
      />
    </p>
    <Cards cards={platformDecisions} />
    <MeterList
      rows={throughput}
      titleZh="每人每小时处理的会话数"
      titleEn="Conversations handled per reviewer per hour"
    />
  </CaseSection>

  <CaseSection index="03" zh="可复算的质量报告" en="A quality report that can be recomputed" audience="DS">
    <p>
      <T
        zh="每次发版都要回答新版本更好还是更坏。这份报告原来全靠人工，<strong>没有人问过报告本身的准确率是多少。</strong>不在我的职责范围里，自己立项做的。"
        en="Every release must answer whether the new version is better or worse. The report was fully manual, and <strong>nobody had asked how accurate the report itself was.</strong> Outside my remit; I started it on my own."
      />
    </p>
    <StepTabs
      id="report"
      steps={report}
      labelZh="数字由脚本算，AI 只负责解释 · 点任意一步"
      labelEn="Scripts compute, the AI only explains · select a step"
    />
    <ul class="case-stats" role="list">
      {reportStats.map((m) => (
        <li>
          <span class="case-stat-value">{m.value}</span>
          <span class="case-stat-label"><T zh={m.zh} en={m.en} /></span>
        </li>
      ))}
    </ul>
    <MeterList
      rows={accuracy}
      titleZh="准确率分项：命中数 / 总数"
      titleEn="Accuracy by part: correct / total"
      noteZh="数字部分全对。根因归因是明确的短板：归不了类的单独列出，不强行归因。"
      noteEn="The numeric part is fully correct. Root-cause attribution is the clear weakness: unclassified items are listed separately rather than forced into a cause."
    />
  </CaseSection>

  <CaseSection index="04" zh="自迭代系统里的验收关" en="The acceptance gate in a self-improving system" audience="PM · SWE">
    <p>
      <T
        zh="研发团队搭了多智能体的自迭代系统 <strong lang='en'>orbit</strong>。找问题和改方案已经能跑，<strong>缺的是验证</strong>。我负责评测和报告两个环节的产品定义。"
        en="The engineering team built <strong>orbit</strong>, a multi-agent self-improving system. Finding problems and revising already worked; <strong>verification was missing</strong>. I owned the product definition of the evaluation and report steps."
      />
    </p>
    <StepTabs
      id="loop"
      steps={loop}
      labelZh="迭代闭环 · 评测不通过就退回上一步"
      labelEn="The loop · a failed evaluation goes back one step"
      captionZh="内部测试中，一次指标波动排查从数天缩到 30 分钟以内。"
      captionEn="In internal testing, investigating a metric swing went from days to under 30 minutes."
    />
  </CaseSection>

  <CaseSection index="05" zh="让找案例变便宜" en="Making it cheap to find the right conversations">
    <Cards cards={search} />
  </CaseSection>

  <CaseSection index="06" zh="踩过的坑" en="What went wrong">
    <Cards cards={lessons} />
  </CaseSection>
</CaseLayout>

<style>
  .case-stats {
    list-style: none;
    margin: 1.5rem 0 0.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem 2rem;
  }
  .case-stats li { display: flex; flex-direction: column; gap: 0.3rem; }
  .case-stat-value {
    font-family: 'Archivo Black', 'Inter', sans-serif;
    font-size: 1.9rem;
    line-height: 1;
    color: #EFE6D3;
    font-variant-numeric: tabular-nums;
  }
  .case-stat-label { color: #9AA3A9; font-size: 0.85rem; line-height: 1.5; }
</style>
