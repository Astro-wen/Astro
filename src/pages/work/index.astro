---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CaseCard from '@/components/CaseCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import T from '@/components/T.astro';
import { CASES } from '@/lib/cases';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="作品 Work" description="做过的产品与个人项目">
  <section class="container-wide py-12 sm:py-16">
    <PageHeader
      zh="作品"
      en="Work"
      leadZh="三个做过的产品，以及几个自己动手做的项目。"
      leadEn="Three products I worked on, plus a few things I built on my own."
    />

    <h2 class="section-eyebrow"><T zh="产品" en="Products" /></h2>
    <ul class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-5" role="list">
      {CASES.map((c) => <li><CaseCard item={c} /></li>)}
    </ul>

    <h2 class="mt-14 section-eyebrow"><T zh="个人项目" en="Side projects" /></h2>
    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>
</BaseLayout>
