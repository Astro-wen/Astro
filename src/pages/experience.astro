---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ExperienceCard from '@/components/ExperienceCard.astro';
import EducationCard from '@/components/EducationCard.astro';
import T from '@/components/T.astro';
import { getCollection } from 'astro:content';
import { sortExperience } from '@/lib/timeline';

const all = await getCollection('timeline');
const education = all
  .filter((t) => t.data.kind === 'education')
  .sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
const experiences = sortExperience(all.filter((t) => t.data.kind === 'work'));
---

<BaseLayout title="经历 Experience" description="工作经历与教育背景">
  <section class="container-wide py-12 sm:py-16">
    <PageHeader
      zh="经历"
      en="Experience"
      leadZh="点任意一段展开细节。"
      leadEn="Select any entry to expand it."
    />

    <h2 class="section-eyebrow"><T zh="工作" en="Work" /></h2>
    <div class="mt-8 space-y-8 sm:space-y-10">
      {experiences.map((entry, i) => (
        <ExperienceCard entry={entry} index={i} number={experiences.length - i} defaultOpen={i === 0} />
      ))}
    </div>

    <h2 class="mt-16 section-eyebrow" id="education"><T zh="教育" en="Education" /></h2>
    <div class="mt-8 space-y-6">
      {education.map((entry, i) => <EducationCard entry={entry} index={i} />)}
    </div>
  </section>
</BaseLayout>

<script>
  // 从首页点某个 logo 进来：地址里带着那一段的名字。展开它，收起其他的，滚到它那里。
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (!target) return;
    document.querySelectorAll<HTMLElement>('.card-expandable').forEach((card) => {
      const on = card === target;
      card.dataset.expanded = on ? 'true' : 'false';
      card.querySelector('.card-trigger')?.setAttribute('aria-expanded', on ? 'true' : 'false');
    });
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 等展开的高度变化落定再滚，不然会停在偏上的位置
    setTimeout(() => target.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'start' }), 80);
  };
  openFromHash();
  addEventListener('hashchange', openFromHash);
</script>

